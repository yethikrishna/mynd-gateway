# Mynd Gateway: pinned upstream new-api + Mynd overlay (theme, branding, About credit).
# Upstream: https://github.com/QuantumNous/new-api (AGPL-3.0). Overlay is embedded below as a base64 tarball.
FROM alpine/git AS src
RUN git clone https://github.com/QuantumNous/new-api /src \
 && cd /src && git checkout 42e694eb60fe3191795c00d416571ced716eb9c4
RUN mkdir /overlay && echo '' | base64 -d | tar xz -C /overlay \
 && cp -r /overlay/web/. /src/web/

FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS builder
WORKDIR /build/web
COPY --from=src /src/web/package.json /src/web/bun.lock ./
RUN bun install --frozen-lockfile
COPY --from=src /src/web ./
COPY --from=src /src/VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder2
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off GOOS=linux GOEXPERIMENT=greenteagc
WORKDIR /build
COPY --from=src /src/go.mod /src/go.sum ./
COPY --from=src /src/relaykit/go.mod ./relaykit/go.mod
COPY --from=src /src/tokenkit/go.mod ./tokenkit/go.mod
RUN go mod download
COPY --from=src /src /build
COPY --from=builder /build/web/dist ./web/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
 && rm -rf /var/lib/apt/lists/* && update-ca-certificates
COPY --from=builder2 /build/new-api /
COPY --from=src /src/LICENSE /src/NOTICE /src/THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
